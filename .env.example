# Image for this site: blank/latest = Sun Peaks, mercerisland = Mercer Island
HUB_IMAGE_TAG=

# Django
DJANGO_SECRET_KEY=any-long-random-string

# Allowed hosts for Django (comma-separated)
ALLOWED_HOSTS=localhost,127.0.0.1
# Public URL of the hub (CSRF trusted origin for logins, Spotify callback base)
HOST=http://your-hub-ip:8000

# PostgreSQL Database
DB_NAME=homehub
DB_HOST=localhost
DB_USER=your_db_user
DB_PASSWORD=your_db_password
# Optional: table-owner login used only for the container's startup migrations.
# When set, DB_USER only needs SELECT/INSERT/UPDATE/DELETE.
DB_MIGRATE_USER=your_db_owner
DB_MIGRATE_PASSWORD=your_db_owner_password

# Django Admin
ADMIN_USER=admin
ADMIN_PASSWORD=your_admin_password

# Spotify API credentials (for Sonos/Spotify integration)
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret

# Home Assistant, and every app's accounts and keys, are set on the hub's
# Settings pages (stored in the database / secret vault), not here.

# During an owner visit the hub acts as signed in as this (non-staff) user.
# Blank turns automatic sign-in off.
HUB_OWNER_VISIT_USER=

##############################
#### Camera Settings       ###
##############################
# WebRTC candidate the cameras app's go2rtc companion advertises to browsers:
# this host's LAN IP and port 8555. deploy/bootstrap.sh fills it in if blank.
BDH_GO2RTC_CANDIDATES=

##############################
#### Optional integrations ###
##############################
# Development remote control for the screens (see .github/copilot-instructions.md);
# blank = off. Keep unset in production.
HUB_REMOTE_TOKEN=
# Container apps: shared secret between the hub and bdh-supervisor (openssl rand -hex 32).
BDH_SUPERVISOR_TOKEN=
